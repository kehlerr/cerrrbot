# ========================================================================================================= #
# General Application & Logging Settings                                                                    #
# ========================================================================================================= #
CERRRBOT_DEBUG=False
CERRRBOT_LOGGING_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR, CRITICAL
CERRRBOT_LOGGING_SCOPE=all            # "app" (cerrrbot logs only) or "all" (includes 3rd-party libs)
CERRRBOT_TIMEZONE="UTC"               # IANA Timezone (e.g. "UTC", "Europe/London", "America/New_York")

# ========================================================================================================= #
# Telegram Bot Core Settings                                                                                #
# ========================================================================================================= #
CERRRBOT_TOKEN="your:bot-token"                     # Telegram Bot Token from @BotFather
CERRRBOT_MODE=polling                               # "auto" | "polling" | "webhook"
CERRRBOT_ALLOWED_USERS='["12345678", "9085120"]'    # Comma-separated list of Telegram User IDs allowed to interact with the bot
CERRRBOT_DATA_ROOT=./appdata                        # Base path for storing downloaded media and files
CERRRBOT_CUSTOM_MESSAGE_MIN_ORDER=100               # Min order number for custom action buttons in inline keyboard
CERRRBOT_MAX_LOAD_FILE_SIZE=20000000                # Max file size in bytes for auto-download (-1 for unlimited)
CERRRBOT_MESSAGE_TTL=169200                         # Message validity TTL in seconds (~47 hours)

# Timeouts & Execution Intervals (in seconds)
CERRRBOT_DELETE_TIMEOUT_1=15                        # Delayed deletion option 1
CERRRBOT_DELETE_TIMEOUT_2=30                        # Delayed deletion option 2
CERRRBOT_DELETE_TIMEOUT_3=45                        # Delayed deletion option 3
CERRRBOT_TIMEOUT_BEFORE_DEFAULT_ACTION_PERFORMS=10  # Delay before executing default action (e.g., auto-download)
CERRRBOT_CHECK_NEW_MESSAGES_CD_PERIOD=3             # Interval to check and execute pending default actions
CERRRBOT_CHECK_DEPRECATED_MESSAGES_CD_PERIOD=60     # Interval to clean up expired messages

# Default Cache Settings (Redis)
CERRRBOT_CACHE_DEFAULT_DB=2
CERRRBOT_CACHE_DEFAULT_KEY_PREFIX="cerrrbot_cache"

# Notifications Settings (Redis)
CERRRBOT_NOTIFICATIONS_DB=3
CERRRBOT_NOTIFICATIONS_CACHE_KEY_PREFIX="cerrrbot_notification"
CERRRBOT_CHECK_NOTIFICATIONS_CD_PERIOD=10 # Interval to check and send due notifications

# ========================================================================================================= #
# Infrastructure Settings                                                                                   #
# ========================================================================================================= #

# MongoDB Settings
CERRRBOT_MONGO_DB_HOST=localhost
CERRRBOT_MONGO_DB_PORT=27017
CERRRBOT_MONGO_DB_NAME=cerrrbot_mongo

# Redis Settings
CERRRBOT_REDIS_HOST=localhost
CERRRBOT_REDIS_PORT=6379
CERRRBOT_REDIS_DB=1

# Celery Task Queue Settings
CERRRBOT_CELERY_BROKER_DB=0
CERRRBOT_CELERY_BACKEND_DB=1

# ========================================================================================================= #
# Local Telegram Bot API Server & Webhook Settings (Optional, required if running bot with "webhook" mode)  #
# ========================================================================================================= #
# Telegram API credentials (https://core.telegram.org/api/obtaining_api_id)
CERRRBOT_TG_API_ID=<your-api-id>
CERRRBOT_TG_API_HASH=<your-api-hash>

# Local Telegram Bot API Server configuration (Required for Webhook & >50MB files)
CERRRBOT_TG_API_SERVER_SCHEME=http
CERRRBOT_TG_API_SERVER_HOST=tg-api-server
CERRRBOT_TG_API_SERVER_PORT=8081
CERRRBOT_TG_API_SERVER_WORK_DIR=/var/lib/telegram-bot-api   # Do not change (!)
CERRRBOT_TG_API_SERVER_CONTAINER_NAME=cerrrbot-tg-api-server

# Webhook Server Settings (Only used when CERRRBOT_MODE=webhook)
CERRRBOT_WEBHOOK_SCHEME=http                # "http" for local TG API server, "https" for reverse proxy
CERRRBOT_WEBHOOK_HOST=0.0.0.0               # Webhook app host
CERRRBOT_WEBHOOK_PORT=8000                  # Webhook app port
CERRRBOT_WEBHOOK_ENDPOINT=/webhook          # Webhook URL path
CERRRBOT_WEBHOOK_SECRET=<any-secret-string> # Telegram webhook secret token

# ========================================================================================================= #
# Docker & Deployment Settings                                                                              #
# ========================================================================================================= #
DOCKERFILE_PATH=./docker/Dockerfile
ENV_FILE=../.env

APP_IMAGE_NAME=cerrrbot_app_dev
APP_INSTANCE_CONTAINER_NAME=app-bot-instance-dev
APP_CELERY_WORKER_CONTAINER_NAME=app-celery-worker-dev
APP_CONTAINER_VOLUME_DATA_DIR_PATH=./appdata/cerrrbot_app/data
DATA_DIR_PATH=/home/app/data

CERRRBOT_REDIS_CONTAINER_NAME=cerrrbot-redis-dev
CERRRBOT_MONGO_CONTAINER_NAME=cerrrbot-mongodb-dev
CERRRBOT_MONGO_CONTAINER_VOLUME_DATA_DIR_PATH=../appdata/mongodb

# ========================================================================================================= #
# Plugins Configuration                                                                                     #
# ========================================================================================================= #
# Plugin-specific settings use prefix <PLUGIN_NAME>_*
# See app/plugins/sample.env for details on configuring installed plugins